/*!50001 CREATE ALGORITHM=UNDEFINED */
/*!50013 DEFINER=`root`@`localhost` SQL SECURITY DEFINER */
/*!50001 VIEW `vw_compras_detalhadas` AS select `c`.`id_compra` AS `ID_COMPRA`,`cli`.`nome` AS `CLIENTE`,`l`.`titulo` AS `LIVRO`,`c`.`qtde` AS `QTDE`,`c`.`valor` AS `VALOR`,`c`.`data_compra` AS `DATA_COMPRA` from ((`compras` `c` join `clientes` `cli` on((`c`.`id_cliente` = `cli`.`id_cliente`))) join `livros` `l` on((`c`.`id_livro` = `l`.`id_livro`))) */;
